# Copie para .env e preencha. Nunca faça commit do .env.

# Banco de dados (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zaptos
DB_USER=
DB_PASSWORD=

# PagBank (sandbox)
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=
PAGBANK_PUBLIC_KEY=
PAGBANK_CLIENT_ID=
PAGBANK_CLIENT_SECRET=
PAGBANK_REDIRECT_URI=
PAGBANK_WEBHOOK_URL=

# A comissão do shopping fica no banco, por categoria (categoria.comissao_percentual).

# App
# Chave que assina os logins. Gere com: py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Por quantas horas o login vale
TOKEN_HORAS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Só em desenvolvimento/testes: aceita o cabeçalho X-Usuario-Id no lugar do login
DEMO_AUTH=0
# 1 = pagamento aprovado na hora, sem PagBank
PAGAMENTO_SIMULADO=1
