# Copie para .env e preencha. Nunca faça commit do .env.

# Banco de dados (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zaptos
DB_USER=
DB_PASSWORD=

# PagBank (sandbox)
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=
PAGBANK_PUBLIC_KEY=
PAGBANK_CLIENT_ID=
PAGBANK_CLIENT_SECRET=
PAGBANK_REDIRECT_URI=
PAGBANK_WEBHOOK_URL=

# A comissão do shopping fica no banco, por categoria (categoria.comissao_percentual).

# App
SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Só em desenvolvimento: identifica o usuário pelo cabeçalho X-Usuario-Id (até o login existir)
DEMO_AUTH=0
# 1 = pagamento aprovado na hora, sem PagBank
PAGAMENTO_SIMULADO=1
